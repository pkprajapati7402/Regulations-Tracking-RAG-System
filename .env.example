# ---- storage ----
# SQLite (default, zero-setup) or Postgres+pgvector:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/regrag
DATABASE_URL=sqlite:///./data/regrag.db

# ---- embeddings ----
# hashing            -> zero-dependency deterministic lexical embeddings (default, CPU, no download)
# sentence-transformers -> BAAI/bge-small-en-v1.5 (needs requirements-ml.txt)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=1024

# ---- reranking ----
# lexical (default) | cross-encoder (needs requirements-ml.txt)
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- generation ----
# extractive (default, no API key) | groq | gemini | openai
LLM_PROVIDER=extractive
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---- retrieval knobs ----
CHUNKER=structure_aware
CHUNK_TOKENS=350
CHUNK_OVERLAP=60
RETRIEVAL_MODE=hybrid_rerank
TOP_K=8
CANDIDATE_K=40
RRF_K=60
